      m_Items: []
  - m_Id: 804483093
    m_Localized: Be quick, it closes soon!
    m_Metadata:
      m_Items: []
  - m_Id: 804483094
    m_Localized: Did you forget? I need eggs from the supermarket.
    m_Metadata:
      m_Items: []
  - m_Id: 804483095
    m_Localized: You got the eggs! Thank you, dear.
    m_Metadata:
      m_Items: []
  - m_Id: 804483096
