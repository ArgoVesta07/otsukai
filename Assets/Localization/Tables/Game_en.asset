  - m_Id: 804483092
    m_Localized: "Oh, it\u2019s you! Could you buy some eggs at the supermarket?"
    m_Metadata:
      m_Items: []
  - m_Id: 804483093
    m_Localized: Be quick, it closes soon!
    m_Metadata:
      m_Items: []
  - m_Id: 804483094
    m_Localized: Did you forget? I need eggs from the supermarket.
    m_Metadata:
      m_Items: []
  - m_Id: 804483095
    m_Localized: You got the eggs! Thank you, dear.
    m_Metadata:
      m_Items: []
  - m_Id: 804483096
    m_Localized: Thanks again for your help today!
    m_Metadata:
      m_Items: []
  - m_Id: 804483097
    m_Localized: "Oh no, the store\u2019s already closed..."
    m_Metadata:
      m_Items: []
  - m_Id: 804483098
    m_Localized: "Let\u2019s try again. Hurry this time!"
    m_Metadata:
      m_Items: []
  - m_Id: 804483099
