  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  npcName: Mom
  targetId: Mom
  promptText: '[E] Interact'
  dialogues:
  - note: 
    errand: {fileID: 11400000, guid: ba99d92e7fc012346b7fb453a626582d, type: 2}
    condition: 1
    step: 0
    requiredFlag: 
    style: 0
    lines:
    - "Oh, it\u2019s you! Could you buy some eggs at the supermarket?"
    - Be quick, it closes soon!
    afterDialogue: 1
    flagToSet: 
  - note: 
    errand: {fileID: 11400000, guid: ba99d92e7fc012346b7fb453a626582d, type: 2}
    condition: 3
    step: 0
    requiredFlag: 
    style: 1
    lines:
    - Did you forget? I need eggs from the supermarket.
    afterDialogue: 0
    flagToSet: 
  - note: 
    errand: {fileID: 11400000, guid: ba99d92e7fc012346b7fb453a626582d, type: 2}
    condition: 3
    step: 1
    requiredFlag: 
    style: 0
    lines:
    - You got the eggs! Thank you, dear.
    afterDialogue: 2
    flagToSet: 
  - note: 
    errand: {fileID: 11400000, guid: ba99d92e7fc012346b7fb453a626582d, type: 2}
    condition: 4
    step: 0
    requiredFlag: 
    style: 1
    lines:
    - Thanks again for your help today!
    afterDialogue: 0
    flagToSet: 
  - note: 
    errand: {fileID: 11400000, guid: ba99d92e7fc012346b7fb453a626582d, type: 2}
    condition: 5
    step: 0
    requiredFlag: 
    style: 0
    lines:
    - "Oh no, the store\u2019s already closed..."
    - "Let\u2019s try again. Hurry this time!"
    afterDialogue: 1
    flagToSet: 
  - note: 
    errand: {fileID: 11400000, guid: ba99d92e7fc012346b7fb453a626582d, type: 2}
    condition: 0
    step: 0
    requiredFlag: 
    style: 1
    lines:
    - "Take a break, you\u2019ve earned it"
    afterDialogue: 0
    flagToSet: 
